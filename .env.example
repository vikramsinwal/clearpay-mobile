# Clearpay Customer Mobile — public client configuration only.
# Copy to `.env` for local development. Never commit secrets.

# REST API base URL (Clearpay backend). Must be HTTPS in production.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# API version prefix used by the mobile client (matches backend /api/v1)
EXPO_PUBLIC_API_VERSION=v1

# Public Telegram bot URL for registration Step 2 (e.g. https://t.me/YourBot).
# Leave unset in environments without a bot — the app shows a config error instead of opening a fake URL.
# EXPO_PUBLIC_TELEGRAM_BOT_URL=https://t.me/ClearpayBot

# Deposit USDT wallet addresses (TRC20 / BEP20) are configured by Admin in
# Settings → Accounts and served by the deposit session / networks APIs.
# Do not set EXPO_PUBLIC_DEPOSIT_* wallet addresses in the mobile client.
